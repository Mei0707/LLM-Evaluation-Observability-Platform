DATABASE_URL=postgresql+psycopg://evalscope:evalscope@postgres:5432/evalscope
REDIS_URL=redis://redis:6379/0
# Local-only prototype. Set a shared access token before allowing remote access.
EVALSCOPE_API_TOKEN=
EVALSCOPE_EMBEDDED_WORKER=false
EVALSCOPE_SEED_DEMO=true
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://api.openai.com/v1
PROVIDER_CONCURRENCY=5
PROVIDER_REQUESTS_PER_SECOND=5
# Enable only with docker compose --profile observability:
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional host ports if defaults are already occupied:
EVALSCOPE_PORT=8000
JAEGER_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
